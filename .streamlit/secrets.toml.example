# Copy this file to secrets.toml and paste your real key.
# Never share secrets.toml and never upload it to GitHub.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Then edit secrets.toml:

API_PROVIDER = "groq"
API_KEY = "paste-your-key-here"

# Optional. Leave blank to use the default model for that provider.
